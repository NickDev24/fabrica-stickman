# API Keys para LLMs
MISTRAL_API_KEY=your_mistral_api_key_here
QWEN_API_KEY=your_qwen_api_key_here
# Pay-As-You-Go Base URL https://ap-southeast-1.maas.qwencloudapi.com/compatible-mode/v1

# Cloudflare Workers AI (Flux para imágenes)
CLOUDFLARED_ACCOUNTS_ID=your_cloudflare_account_id
CLOUDFLARED_WORKER_AI=your_cloudflare_worker_ai_token

# Amazon Bedrock
BADROCK_API_KEY=your_bedrock_api_key_here

# Aion Labs
AIONLABS_API_KEY=your_aionlabs_api_key_here

# Telegram (para notificaciones)
TELEGRAM_TOKEN_BOT=your_telegram_bot_token
TELEGRAM_CHAT_ID=your_telegram_chat_id

# Zernio (publicación social)
ZERNIO_API_KEY=your_zernio_api_key
ZERNIO_ACCOUNT_ID=your_zernio_account_id
ZERNIO_FACEBOOK_ID=your_zernio_facebook_id
ZERNIO_YOUTUBE_ID=your_zernio_youtube_id

# Publicación automática
AUTO_PUBLISH=false

# Kaggle
KAGGLE_API_KEY=your_kaggle_api_key

# Hugging Face
HUGGINFACE_TOKEN=your_huggingface_token

# Google Cloud / Gemini
GEMINI_API_KEY=your_gemini_api_key
GOOGLE_GEMINI_API_KEY=your_google_gemini_api_key
NAME_PROJECT=your_project_name

# Configuración de proveedores LLM
# opt-in proveedor PAGO (Gemini) con tope mensual duro
ALLOW_PAID_LLM=0
GEMINI_PRESUPUESTO_USD_MES=6.00
# Proveedores gratis de nube (mistral/qwen/cloudflare)
ALLOW_REMOTE_LLM=1
# Freno local de imágenes en Workers AI (Flux, gratis)
CF_MAX_IMAGENES_DIA=150

# Pollinations
POLLINATIONS_API_KEY=your_pollinations_api_key

# Variables de entorno para Docker
HOME=/home/facu
PYTHONUNBUFFERED=1
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
KF_RECICLADO_CADA=2
FACTORY_PUBLISH=0
