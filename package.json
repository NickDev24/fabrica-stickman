{
  "name": "fabrica-stickman",
  "version": "0.1.0",
  "private": true,
  "description": "Autonomous content factory with a 2D stickman office onboarding experience.",
  "license": "MIT",
  "author": "NickDev24 <facucercuetti420@gmail.com>",
  "repository": {
    "type": "git",
    "url": "https://github.com/NickDev24/fabrica-stickman.git"
  },
  "scripts": {
    "dev:web": "pnpm --filter @fabrica/web dev",
    "build": "pnpm --filter @fabrica/web build && pnpm --filter @nickdev24/fabrica-autonoma build",
    "test": "cd pipeline && ../.venv/bin/python -m pytest tests -q",
    "lint": "eslint . --ext .ts,.tsx",
    "typecheck": "pnpm -r typecheck",
    "docker:up": "docker compose up -d --build",
    "docker:down": "docker compose down",
    "docker:logs": "docker compose logs -f"
  },
  "engines": {
    "node": ">=20.0.0",
    "pnpm": ">=9.0.0"
  },
  "packageManager": "pnpm@9.12.0",
  "devDependencies": {
    "@types/three": "^0.187.0"
  }
}
